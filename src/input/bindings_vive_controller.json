{
  "controller_type": "vive_controller",
  "name": "GODAN Overlay 標準",
  "description": "トリガー=クリック, グリップ=つかむ, 左メニュー 2回押し=時計, トラックパッド=スクロール",
  "bindings": {
    "/actions/main": {
      "sources": [
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/click"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/click"
            }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/grab"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/grab"
            }
          }
        },
        {
          "path": "/user/hand/left/input/application_menu",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/main/in/watchtoggle"
            }
          }
        }
      ],
      "poses": [
        {
          "output": "/actions/main/in/pointer",
          "path": "/user/hand/left/pose/tip"
        },
        {
          "output": "/actions/main/in/pointer",
          "path": "/user/hand/right/pose/tip"
        }
      ],
      "haptics": [
        {
          "output": "/actions/main/out/haptic",
          "path": "/user/hand/left/output/haptic"
        },
        {
          "output": "/actions/main/out/haptic",
          "path": "/user/hand/right/output/haptic"
        }
      ]
    },
    "/actions/stick": {
      "sources": [
        {
          "path": "/user/hand/left/input/trackpad",
          "mode": "trackpad",
          "inputs": {
            "position": {
              "output": "/actions/stick/in/scroll"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trackpad",
          "mode": "trackpad",
          "inputs": {
            "position": {
              "output": "/actions/stick/in/scroll"
            }
          }
        }
      ]
    }
  }
}